# /etc/mantis-filter/mantis-filter.env — edit before starting the service.
# systemctl restart mantis-filter after changes.

RUST_LOG=info

# Control plane this node reports to and pulls policy bundles from. Use HTTPS
# for remote control planes; plain HTTP is only suitable on the same host or a
# tightly controlled private link.
CONTROL_URL=https://control.example.internal

# Per-node credential (design.md §26 R3) — issue with, as an admin:
#   POST /api/v1/nodes/credentials {"node_name": "this-node"}
# The response's "token" field is shown once; put it in MANTIS_NODE_TOKEN.
# Revoke/rotate via POST /api/v1/nodes/credentials/{node_name}/revoke|rotate.
MANTIS_NODE_NAME=
MANTIS_NODE_TOKEN=

# Optional sha256 hex digest of the control plane's Ed25519 public key. Set on
# remote nodes to pin the trust anchor fetched from /api/v1/public-key.
MANTIS_CONTROL_PUBLIC_KEY_SHA256=

# Leave unset to run in multi-tenant source-IP routing mode. Set to pin this
# node to a single DHCP-DDNS group instead.
GROUP_ID=

# Listen address:port for DNS queries. CAP_NET_BIND_SERVICE (granted by the
# unit file) allows binding :53 without running as root.
DNS_BIND_ADDR=0.0.0.0:53

# Optional: co-hosted block-page HTTP listener, used when a policy's block
# mode is REDIRECT (docs/design-block-page.md). Unset = listener never
# starts and REDIRECT mode silently has no page to show. Set to "0.0.0.0:80"
# so plain http:// navigations reach it without a client typing a port —
# CAP_NET_BIND_SERVICE (above) covers :80 the same way it covers :53. Point
# the policy's redirect_ipv4/redirect_ipv6 at whatever address this node is
# reachable on; if this filter shares a box with the UI/mgmt-plane LXC, give
# the filter its own IP first (see docs/deploy-lxc.md Option B) — the UI's
# nginx already owns :80/:443 on its own address.
BLOCKPAGE_BIND_ADDR=
